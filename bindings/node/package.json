{
  "name": "fluxwright",
  "version": "0.6.0",
  "description": "Run hundreds of headless Chrome jobs on one machine: pooling, queueing, recycling and crash recovery, with a Playwright-style API.",
  "main": "addon.js",
  "types": "addon.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshit-d3v/fluxwright.git",
    "directory": "bindings/node"
  },
  "homepage": "https://fluxwright.vercel.app",
  "bugs": {
    "url": "https://github.com/harshit-d3v/fluxwright/issues"
  },
  "keywords": [
    "chromium",
    "chrome",
    "headless",
    "playwright",
    "puppeteer",
    "browser-pool",
    "browser-automation",
    "scraping",
    "cdp",
    "napi-rs"
  ],
  "author": "Fluxwright contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "addon.js",
    "addon.d.ts",
    "index.js",
    "index.d.ts",
    "MISSING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "test": "node test/smoke.mjs",
    "test:types": "tsc -p test",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi pre-publish -t npm --no-gh-release"
  },
  "napi": {
    "binaryName": "fluxwright",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "fluxwright-darwin-arm64": "0.6.0",
    "fluxwright-darwin-x64": "0.6.0",
    "fluxwright-linux-x64-gnu": "0.6.0",
    "fluxwright-win32-x64-msvc": "0.6.0"
  }
}
