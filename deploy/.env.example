# Required: 32-256 printable ASCII characters with no whitespace.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLUXWRIGHT_SERVER_TOKEN=replace-with-random-64-char-hex-token-before-starting

# Optional: HMAC-SHA256 secret for signing terminal job webhooks (X-Fluxwright-Signature)
# FLUXWRIGHT_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Optional: separate bearer token for coordinator/worker cluster leases
# FLUXWRIGHT_WORKER_TOKEN=replace-with-worker-token

# Optional: OTLP/HTTP JSON trace collector base URL
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=fluxwright-server

# Only set on platforms that disallow Linux user namespaces (such as locked-down PaaS sandboxes).
# Docker Compose and Kubernetes setups with SYS_ADMIN keep Chrome sandboxing enabled by default.
# FLUXWRIGHT_NO_SANDBOX=1
